# PorchLight backend configuration — copy to .env and edit.
# Without AWS credentials the app runs in offline-stub mode (safe for local dev).

# Amazon Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Standard AWS credential env vars (do NOT commit real keys):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Snapshots: set S3_BUCKET to store in S3, otherwise a local dir is used
# S3_BUCKET=
SNAPSHOTS_DIR=snapshots

# Optional outbound webhook for alert fan-out (push/email bridge)
# ALERT_WEBHOOK_URL=

# CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Ring webhook security — set a secret to require HMAC-signed webhooks.
# Leave empty for unsigned local dev; the simulator reads the same var.
# RING_WEBHOOK_SECRET=
RING_SIGNATURE_HEADER=x-ring-signature
# Ring sandbox API (exact endpoints confirmed in M0 — docs/ring-integration.md)
# RING_API_BASE_URL=
# RING_BEARER_TOKEN=

# Alert policy
FALL_CONFIDENCE_THRESHOLD=0.6
LOITERING_CONFIDENCE_THRESHOLD=0.7
QUIET_HOURS_START=22
QUIET_HOURS_END=7
